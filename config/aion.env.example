# $AION_HOME/config/aion.env — single source of truth for all scripts
AION_HOME=

# --- GPU placement (pinned by UUID, never by index) ---
# V100 #1 32GB — conscious workspace
AION_GPU_MAIN=
# V100 #2 32GB — intuition layer (parallel subconscious)
AION_GPU_INTUITION=
# P40 #1 — embedding + graph + graphify
AION_GPU_SUB=
# P40 #2 — art generation (FLUX) + spillover
AION_GPU_UTIL=

# --- models (v3 topology: 2xV100 conscious+intuition, 2xP40 graph+art) ---
# Main ollama (V100 #1, port 11436) — conscious workspace
OLLAMA_MAIN_URL=
# Conscious model: gemma4:31b-65k (multimodal — also handles vision)
MAIN_MODEL=

# Code model: qwen3.8:27b on its own instance (V100 #3 loaned, :11439)
# If the loan GPU is removed, code_endpoint() falls back to gemma4 on :11436
OLLAMA_CODE_URL=
CODE_MODEL=
CODE_NUM_CTX=
MAIN_NUM_CTX=

# Intuition ollama (V100 #2, port 11438) — parallel subconscious
OLLAMA_INTUITION_URL=
INTUITION_MODEL=
INTUITION_NUM_CTX=

# Graphify ollama (P40 #1, port 11437) — embedding + graph
OLLAMA_SUB_URL=
SUB_MODEL=
EMBED_MODEL=

# --- graphify (uses P40 #1) ---
GRAPHIFY_OLLAMA_URL=
GRAPHIFY_OLLAMA_NUM_CTX=
GRAPHIFY_TOKEN_BUDGET=
GRAPHIFY_MAX_CONCURRENCY=
GRAPHIFY_API_TIMEOUT=

# --- homeostasis setpoints ---
DISK_MAX_PCT=
# 2500 (Sep 10): nightly clears ~1600/day; 1000 fired daily
# self-wake spam with no actuator. Aligned with homeostasis fallback.
UNCONSOLIDATED_MAX_EVENTS=
QUESTION_STALE_DAYS=
LOG_SILENCE_MAX_HOURS=
COMPETENCE_STALE_DAYS=

# --- external oracle (weekly audit; key kept OUT of Aion's own env) ---
# GLM_API_KEY is read from $AION_HOME/config/secrets.env by audit.sh only
GH_TOKEN=

# Pin consolidation to subconscious (non-thinking) model — thinking models fabricate event IDs
OLLAMA_CONSOLIDATE_URL=
OLLAMA_CONSOLIDATE_MODEL=
GRAPHIFY_DISABLE_THINKING=
CRITIC_MODEL=
